# TA-01 waveforms are regenerable by `python model/ta01/run_ta01.py`
model/ta01/*.bin
__pycache__/

# TA-01b/c generated artifacts (regenerable)
model/ta01b/*.bin
model/ta01b/zone/tax_*.tck
model/ta01c/*.res
# Imitator stdout captured by run_sampled.sh so the gate can read its exit
# status without losing the output to a pipe (regenerable)
model/ta01c/*.stdout

# Imitator stdout captured by run_imi.sh so the gate can read the exit status
# without losing the output to a pipe (regenerable)
model/ta02/*.stdout

# A2 generated artifacts (regenerable)
#   .tck models are emitted per bisection step by model/a2/zone/run_edf.py
#   -- 49 of them for one full cross-check. gen_edf.py is the source of truth.
model/a2/zone/*.tck
model/a2/*.bin
model/a2/wave_jit_*.bin

# iverilog/vvp build artefacts from the smoke bench
*.vvp

# Parameterised bench images, regenerated by test/make_smoke_image.py.
# smoke_image.hex IS tracked -- it is the one fixed program the shipped C/J
# measurements come from. These three are swept over their delay parameters, so
# committing one snapshot would record an artefact whose generating arguments
# are not in the file. test/run_mutants.py regenerates the one it needs.
test/stress_image.hex
test/five_image.hex
test/chain_image.hex
test/census_image.hex
test/noop_image_h19.hex
test/noop_image_bad.hex
test/noop_image.hex
test/edge_image_rise.hex
test/edge_image_noto.hex
test/edge_image.hex

# Written when the bench runs a NON-default image; the default program's
# measurements live in test/cj_measured.txt and are tracked.
test/cj_measured_alt.txt

# ⛔ PROBE OUTPUTS. Experiments and sweeps write only to these names; the
# reserved artefact names belong to their generators and the manifest. The
# J investigation overwrote test/five_image.hex with an experiment set and the
# clean room caught it only afterwards -- the rule is what stops it.
test/probe_*.hex
# ⛔ AND MEASUREMENTS, NOT ONLY IMAGES. The coverage sweep runs `tb_smoke`
# under Verilator, which disagrees with iverilog by one cycle on `hdr_cyc`, so
# its numbers must land on a scratch name rather than on the pinned
# `cj_measured.txt` -- which it rewrote once before this rule existed.
test/probe_*.txt
test/artefacts.sha256.probe
# ⛔ PROBES WRITE ONLY TO SCRATCH NAMES, and the pattern has to cover the
# WRAPPER SCRIPTS too. Yosys is only on the PATH inside WSL here, so running
# the reset audit's netlist step by hand needs a tiny `probe_*.sh` in the tree
# (WSL cannot see Git Bash's /tmp, and `bash -c` inline is forbidden by the
# toolchain rules). Those wrappers are scratch and must never be committed.
probe_*.sh
probe_*.json
# ⛔ AND THE DIRECTORIES THEY WRITE INTO. `ci/run_gates.sh` delegates the
# netlist step to WSL when yosys is not on PATH, and WSL cannot see Git Bash's
# /tmp -- so the JSON lands in `probe_nl/` inside the repo, where both sides
# can reach it. A 10 MB generated netlist must never be committed.
probe_*/
probe_*.bin
test/probe_*.vh
# a Verilator sim writes ./coverage.dat by default; the sweep moves it per
# arm, but an aborted run can leave one behind
coverage.dat

# scratch diagnostics, like probe_* -- never suite artefacts
test/diag_*.py

# Ruling TF4's SymbiYosys proof: the miter is GENERATED from src/pe_engine.v
# on every run (formal/make_argmin_miter.py), and sby writes one work
# directory per .sby file -- neither is a source
formal/build/
formal/argmin_equiv/
formal/argmin_equiv_mut/
formal/preselect_equiv/
formal/preselect_equiv_mut/

# FPGA bring-up: Vivado writes its bitstream, reports and checkpoints here
fpga/build/
.Xil/
vivado*.jou
vivado*.log
# the UART-rx and hold-offset gates' simulation build directories
test/sim_build_uartrx/
test/sim_build_hold/
test/sim_build_rxfast/
test/sim_build_wfmf/
test/sim_build_uarttx/
test/sim_build_reload/
test/sim_build_v2win/
# ⛔ EVERY runner build dir, by pattern (Wilson 10-19): test/sim_run.py grants
# a scratch pass only to IGNORED, untracked paths, and the list above left a
# new `test/sim_build_<x>/` tracked by default
test/sim_build*/
# test/sim_run.py's provenance manifest, written beside each registered
# generator's scratch image (found in test/ after the first full suite)
.sim_run_scratch.json
