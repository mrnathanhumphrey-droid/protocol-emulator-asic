/* the LOOSENING-override allowlist (model/v3_table.py ALLOW):
 * field 1 bound, 2 dtol, 3 exempt, 4 underrun; value -1 = any.
 * Returns 1 iff (image, field, value) is allowlisted. */
function integer v3_allow;
  input [31:0] h;
  input integer field;
  input integer value;
