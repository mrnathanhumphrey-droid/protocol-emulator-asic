/* the LOOSENING-override allowlist (model/v3_table.py ALLOW):
 * field 1 bound, 2 dtol, 3 exempt, 4 underrun; value -1 = any.
 * Returns 1 iff (image, field, value) is allowlisted. */
function integer v3_allow;
  input [31:0] h;
  input integer field;
  input integer value;
  begin
    v3_allow = 0;
    if (h == 32'h33dc8ba2 && field == 4 && value == 1) v3_allow = 1;  // ckfive_image.hex: tb_csat measures dispatch spacing and pushes no host byte by
    if (h == 32'hdb08ab91 && field == 4 && value == 2) v3_allow = 1;  // run_cktx: cktx.hex: run_cktx's STARVE arm stops topping up the queues for a wind
    if (h == 32'h7e3b3294 && field == 4 && value == 2) v3_allow = 1;  // probe_cov_pindiv.hex: run_cktx's STARVE arm on the pindiv image (same declared win
    if (h == 32'ha0fbaea9 && field == 1) v3_allow = 1;  // run_wirefeed_mf: old WS2812 (REARM d=0): the refused delay-0 build has no lane set of its own, so it 
  end
endfunction
