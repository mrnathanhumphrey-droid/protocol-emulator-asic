# Must-fires for argmin_equiv.sby, two of them, each built into the same miter
# file and each required to FAIL (a counterexample is the pass):
#   --mutate     the first node breaks the lowest-index tie rule (`<=`)
#   --mutate-oh  lane 0's one-hot line drops `v01`, so it fires with no
#                lane ready (TF2-R5); only the one-hot assertion catches it
# Run: python formal/make_argmin_miter.py --mutate[-oh] && sby -f formal/argmin_equiv_mut.sby
[options]
mode prove
depth 1

[engines]
smtbmc yices

[script]
read -formal argmin_miter_mut.sv
prep -top argmin_miter

[files]
build/argmin_miter_mut.sv
